{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "metric_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,127}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "host_id",
        "boot_id",
        "entity_id",
        "metric_id",
        "scope"
      ]
    },
    "start_boot_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "end_boot_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "covered_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "coverage_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "truncated": {
      "type": "boolean"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_boot_ns": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "end_boot_ns": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "value": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "const": "f64"
                      },
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "const": "u64"
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,19})$"
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "covered_ns": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "method": {
            "enum": [
              "raw",
              "time_weighted_step",
              "counter_delta",
              "estimated_integral",
              "bucket_exact",
              "boundary_gap",
              "gap"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 4
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        },
        "required": [
          "start_boot_ns",
          "end_boot_ns",
          "value",
          "covered_ns",
          "method",
          "source_ids",
          "reason"
        ]
      },
      "maxItems": 2000
    },
    "source_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,19})$"
      },
      "maxItems": 2000
    },
    "clock_discontinuities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,19})$"
      },
      "maxItems": 2000
    },
    "snapshot_revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "next_start_boot_ns": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "key",
    "start_boot_ns",
    "end_boot_ns",
    "covered_ns",
    "coverage_ratio",
    "truncated",
    "points",
    "source_changes",
    "clock_discontinuities",
    "snapshot_revision",
    "next_start_boot_ns"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "歷史結果 v1"
}
