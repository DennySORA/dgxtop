{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "metric_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,127}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "host_id",
        "boot_id",
        "entity_id",
        "metric_id",
        "scope"
      ]
    },
    "start_boot_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "end_boot_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "resolution_ms": {
      "oneOf": [
        {
          "const": 0
        },
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 86400000
        }
      ]
    },
    "stat": {
      "enum": [
        "mean",
        "min",
        "max",
        "total",
        "raw"
      ]
    },
    "max_points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "source_filter": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "key",
    "start_boot_ns",
    "end_boot_ns",
    "resolution_ms",
    "stat",
    "max_points",
    "source_filter"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "歷史查詢 v1"
}
